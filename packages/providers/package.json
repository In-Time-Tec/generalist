{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@batonfx/providers",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./catalog": "./src/catalog.ts",
    "./openai": "./src/openai.ts",
    "./anthropic": "./src/anthropic.ts",
    "./openrouter": "./src/openrouter.ts",
    "./openai-compat": "./src/openai-compat.ts",
    "./deterministic": "./src/deterministic.ts",
    "./presets": "./src/presets.ts",
    "./embedding": "./src/embedding.ts"
  },
  "scripts": {
    "build": "bun build ./src/index.ts ./src/catalog.ts ./src/openai.ts ./src/anthropic.ts ./src/openrouter.ts ./src/openai-compat.ts ./src/deterministic.ts ./src/presets.ts ./src/embedding.ts --outdir dist --target bun --format esm",
    "lint": "bun --cwd ../.. oxlint packages/providers/src packages/providers/test",
    "test": "bun --cwd ../.. vitest run packages/providers/test --passWithNoTests",
    "typecheck": "bun tsc --noEmit"
  },
  "dependencies": {
    "@batonfx/core": "workspace:*",
    "@effect/ai-anthropic": "catalog:",
    "@effect/ai-openai": "catalog:",
    "@effect/ai-openai-compat": "catalog:",
    "@effect/ai-openrouter": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
