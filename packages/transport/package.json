{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@batonfx/transport",
  "version": "0.12.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/transport/client.d.ts",
      "import": "./dist/transport/client.js"
    },
    "./errors": {
      "types": "./dist/transport/errors.d.ts",
      "import": "./dist/transport/errors.js"
    },
    "./sse": {
      "types": "./dist/transport/sse.d.ts",
      "import": "./dist/transport/sse.js"
    },
    "./ws": {
      "types": "./dist/transport/ws.d.ts",
      "import": "./dist/transport/ws.js"
    },
    "./wire": {
      "types": "./dist/transport/wire.d.ts",
      "import": "./dist/transport/wire.js"
    },
    "./session-registry": {
      "types": "./dist/session/session-registry.d.ts",
      "import": "./dist/session/session-registry.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun tsc -p tsconfig.build.json",
    "lint": "bun --cwd ../.. oxlint packages/transport/src packages/transport/test",
    "test": "bun --cwd ../.. vitest run packages/transport/test",
    "typecheck": "bun tsc --noEmit"
  },
  "dependencies": {
    "@batonfx/core": "workspace:*"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@batonfx/test": "workspace:*",
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "description": "Replayable SSE, WebSocket, wire, and session transport primitives for Baton",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/In-Time-Tec/batonfx.git",
    "directory": "packages/transport"
  },
  "homepage": "https://github.com/In-Time-Tec/batonfx#readme",
  "bugs": {
    "url": "https://github.com/In-Time-Tec/batonfx/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
