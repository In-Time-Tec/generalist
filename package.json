{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "batonfx",
  "description": "Standalone, non-durable, Effect-native agent framework",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "bun turbo build",
    "check": "bun run vendor:check && bun run format:check && bun run lint && bun run typecheck && bun run check:docs && bun run typecheck:examples && bun run test && bun run build && bun run check:release && bun run package:smoke",
    "check:docs": "bun scripts/check-docs.ts",
    "check:examples": "bun scripts/check-examples.ts",
    "check:release": "bun scripts/check-release.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint packages apps examples scripts && ast-grep scan --config sgconfig.yml",
    "package:smoke": "bun scripts/package-smoke.ts",
    "postinstall": "bun run vendor:setup",
    "test": "bun turbo test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "bun turbo typecheck && effect-tsgo diagnostics --project ./tsconfig.json --format pretty --strict",
    "typecheck:examples": "bun run check:examples && bash -lc 'set -euo pipefail; for dir in examples/*; do (cd \"$dir\" && bun run typecheck); done'",
    "vendor:check": "./scripts/vendor-check.sh",
    "vendor:setup": "git config core.hooksPath .githooks && git config submodule.recurse true && bun run vendor:update",
    "vendor:update": "./.githooks/vendor-sync"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "examples/*",
      "examples/*/*"
    ],
    "catalog": {
      "@ast-grep/cli": "0.44.0",
      "@effect/ai-anthropic": "4.0.0-beta.93",
      "@effect/ai-openai": "4.0.0-beta.93",
      "@effect/ai-openai-compat": "4.0.0-beta.93",
      "@effect/ai-openrouter": "4.0.0-beta.93",
      "@effect/platform-bun": "4.0.0-beta.93",
      "@effect/tsgo": "0.21.0",
      "@effect/vitest": "4.0.0-beta.93",
      "@foldkit/ui": "0.122.0",
      "@foldkit/vite-plugin": "0.10.0",
      "@modelcontextprotocol/sdk": "1.29.0",
      "@tailwindcss/vite": "4.3.2",
      "@tsconfig/bun": "1.0.9",
      "@types/bun": "1.3.13",
      "@types/node": "24.12.2",
      "@vitest/coverage-v8": "4.0.16",
      "class-variance-authority": "0.7.1",
      "clsx": "2.1.1",
      "effect": "4.0.0-beta.93",
      "foldkit": "0.122.0",
      "happy-dom": "20.10.6",
      "oxlint": "1.60.0",
      "oxlint-tsgolint": "0.21.0",
      "prettier": "3.6.2",
      "tailwind-merge": "3.6.0",
      "tailwindcss": "4.3.2",
      "turbo": "2.8.13",
      "typescript": "7.0.2",
      "vite": "8.1.3",
      "vitest": "4.0.16"
    }
  },
  "dependencies": {
    "@batonfx/core": "workspace:*",
    "@batonfx/foldkit": "workspace:*",
    "@batonfx/memory": "workspace:*",
    "@batonfx/mcp": "workspace:*",
    "@batonfx/providers": "workspace:*",
    "@batonfx/skills": "workspace:*",
    "@batonfx/test": "workspace:*",
    "@batonfx/transport": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@ast-grep/cli": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false
  }
}
