{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@batonfx/transport",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./errors": "./src/errors.ts",
    "./sse": "./src/sse.ts",
    "./ws": "./src/ws.ts",
    "./wire": "./src/wire.ts",
    "./session-registry": "./src/session-registry.ts"
  },
  "scripts": {
    "build": "bun build ./src/index.ts ./src/wire.ts ./src/session-registry.ts ./src/errors.ts ./src/sse.ts ./src/ws.ts ./src/client.ts --outdir dist --target bun --format esm",
    "lint": "bun --cwd ../.. oxlint packages/transport/src packages/transport/test",
    "test": "bun --cwd ../.. vitest run packages/transport/test --passWithNoTests",
    "typecheck": "bun tsc --noEmit"
  },
  "dependencies": {
    "@batonfx/core": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@batonfx/test": "workspace:*",
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
