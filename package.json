{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "batonfx",
  "version": "0.11.8",
  "description": "Standalone, non-durable, Effect-native agent framework",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "bun turbo build",
    "check": "prettier --cache --check . && oxlint packages apps examples scripts test && ast-grep scan --config sgconfig.yml --filter '^(no-|tenant-|update-)' && bun run typecheck && bun run test && bun run package",
    "dev": "bun --cwd apps/docs dev",
    "format": "prettier --write .",
    "package": "bun scripts/package-smoke.ts",
    "test": "bun turbo test",
    "typecheck": "ast-grep scan --config sgconfig.yml --filter '^effect-' --report-style short && bun turbo typecheck && effect-tsgo diagnostics --project ./tsconfig.json --format pretty --strict"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "examples/*",
      "examples/*/*"
    ],
    "catalog": {
      "@ast-grep/cli": "0.44.0",
      "@aws-sdk/client-bedrock-runtime": "3.859.0",
      "@aws-sdk/credential-provider-node": "3.859.0",
      "@smithy/types": "4.3.1",
      "@effect/ai-anthropic": "4.0.0-beta.98",
      "@effect/ai-openai": "4.0.0-beta.98",
      "@effect/ai-openai-compat": "4.0.0-beta.98",
      "@effect/ai-openrouter": "4.0.0-beta.98",
      "@effect/platform-bun": "4.0.0-beta.98",
      "@effect/tsgo": "0.21.0",
      "@effect/vitest": "4.0.0-beta.98",
      "@foldkit/ui": "0.122.0",
      "@foldkit/vite-plugin": "0.10.0",
      "@modelcontextprotocol/sdk": "1.29.0",
      "@tailwindcss/vite": "4.3.2",
      "@tsconfig/bun": "1.0.9",
      "@types/bun": "1.3.13",
      "@types/node": "24.12.2",
      "@vitest/coverage-v8": "4.0.16",
      "class-variance-authority": "0.7.1",
      "clsx": "2.1.1",
      "effect": "4.0.0-beta.98",
      "foldkit": "0.122.0",
      "happy-dom": "20.10.6",
      "oxlint": "1.60.0",
      "oxlint-tsgolint": "0.21.0",
      "prettier": "3.6.2",
      "tailwind-merge": "3.6.0",
      "tailwindcss": "4.3.2",
      "turbo": "2.8.13",
      "typescript": "7.0.2",
      "vite": "8.1.3",
      "vitest": "4.0.16"
    }
  },
  "dependencies": {
    "@batonfx/core": "workspace:*",
    "@batonfx/foldkit": "workspace:*",
    "@batonfx/memory": "workspace:*",
    "@batonfx/mcp": "workspace:*",
    "@batonfx/providers": "workspace:*",
    "@batonfx/skills": "workspace:*",
    "@batonfx/test": "workspace:*",
    "@batonfx/transport": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@ast-grep/cli": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false
  }
}
