{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "generalist-workspace",
  "version": "0.65.3",
  "description": "Effect-native agent framework with an optional durable Runtime",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build": "bun turbo build",
    "check": "bun run build && bun run docs:build && prettier --cache --check . && repo-lint check --no-cache && bun node_modules/oxlint/dist/cli.js --deny-warnings packages examples scripts test docs/src docs/server docs/vite.config.ts vitest.config.ts && ast-grep scan --config sgconfig.yml --filter '^(no-|tenant-|update-)' && bun run typecheck",
    "install-preflight": "bun scripts/install-preflight.ts",
    "dev": "bun run --cwd docs dev",
    "docs:build": "bun scripts/docs-features.ts && bun run --cwd docs build",
    "format": "prettier --write .",
    "package": "bun scripts/package-smoke.ts",
    "readme:check": "bun scripts/readme-check.ts",
    "test": "bun run build && bun --bun vitest run && bun scripts/render-hosts.ts --check && bun scripts/render-openapi.ts --check && bun run readme:check && bun run verify-scripted-surfaces",
    "typecheck": "ast-grep scan --config sgconfig.yml --filter '^effect-' --report-style short && bun turbo typecheck && bun tsc --noEmit -p tsconfig.json",
    "verify-scripted-surfaces": "bun scripts/verify-scripted-surfaces.ts",
    "prepare": "effect-tsgo patch --no-typescript --oxlint"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "docs",
      "examples/*",
      "examples/*/*"
    ],
    "catalog": {
      "@a2a-js/sdk": "1.0.1",
      "@ag-ui/core": "0.0.57",
      "@ast-grep/cli": "0.44.0",
      "@aws-sdk/client-bedrock-runtime": "3.859.0",
      "@aws-sdk/client-s3": "3.1124.0",
      "@aws-sdk/credential-provider-node": "3.859.0",
      "@smithy/types": "4.3.1",
      "@smithy/fetch-http-handler": "5.7.2",
      "@effect/ai-anthropic": "4.0.0-rc.112",
      "@effect/ai-openai": "4.0.0-rc.112",
      "@effect/ai-openai-compat": "4.0.0-rc.112",
      "@effect/ai-openrouter": "4.0.0-rc.112",
      "@effect/platform-bun": "4.0.0-rc.112",
      "@effect/platform-node-shared": "4.0.0-rc.112",
      "@effect/tsgo": "0.36.5",
      "@effect/vitest": "4.0.0-rc.112",
      "@rivet-dev/agentos": "0.2.19",
      "@standard-schema/spec": "1.1.0",
      "@foldkit/ui": "0.148.2",
      "@foldkit/vite-plugin": "0.16.1",
      "@modelcontextprotocol/sdk": "1.29.0",
      "@oxlint/plugins": "1.78.0",
      "@tailwindcss/vite": "4.3.2",
      "@tsconfig/bun": "1.0.9",
      "@types/bun": "1.4.0",
      "@types/node": "24.12.2",
      "@vitest/coverage-v8": "4.1.11",
      "class-variance-authority": "0.7.1",
      "clsx": "2.1.1",
      "effect": "4.0.0-rc.112",
      "es-module-lexer": "2.3.2",
      "esbuild": "0.28.2",
      "foldkit": "0.148.2",
      "happy-dom": "20.10.6",
      "modal": "0.10.0",
      "oxlint": "1.78.0",
      "oxlint-tsgolint": "7.0.2001",
      "prettier": "3.6.2",
      "rivetkit": "2.3.15",
      "tailwind-merge": "3.6.0",
      "tailwindcss": "4.3.2",
      "turbo": "2.8.13",
      "typescript": "7.0.2",
      "vite": "8.1.3",
      "vitest": "4.1.11",
      "wrangler": "4.123.0",
      "yjs": "13.6.32"
    },
    "catalogs": {
      "peer": {
        "foldkit": "0.148.2"
      }
    }
  },
  "dependencies": {
    "effect": "catalog:",
    "generalist": "workspace:*"
  },
  "devDependencies": {
    "@ast-grep/cli": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@rikalabs/repo-lint": "2.3.0",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "alchemy": "2.0.0-beta.76",
    "happy-dom": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false
  }
}
