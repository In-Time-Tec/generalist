{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "error",
    "suspicious": "error"
  },
  "ignorePatterns": ["dist", "node_modules", ".turbo"],
  "overrides": [
    {
      "files": ["packages/*/src/**/*.ts"],
      "rules": {
        "max-lines": ["error", { "max": 500, "skipBlankLines": false, "skipComments": false }]
      }
    }
  ]
}
