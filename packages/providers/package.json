{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@batonfx/providers",
  "version": "0.21.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/catalog.d.ts",
      "import": "./dist/catalog/catalog.js"
    },
    "./openai": {
      "types": "./dist/provider/openai.d.ts",
      "import": "./dist/provider/openai.js"
    },
    "./openai-account-auth": {
      "types": "./dist/provider/openai-account-auth.d.ts",
      "import": "./dist/provider/openai-account-auth.js"
    },
    "./openai-account-auth-http": {
      "types": "./dist/provider/openai-account-auth-http.d.ts",
      "import": "./dist/provider/openai-account-auth-http.js"
    },
    "./anthropic": {
      "types": "./dist/provider/anthropic.d.ts",
      "import": "./dist/provider/anthropic.js"
    },
    "./amazon-bedrock": {
      "types": "./dist/provider/amazon-bedrock.d.ts",
      "import": "./dist/provider/amazon-bedrock.js"
    },
    "./openrouter": {
      "types": "./dist/provider/openrouter.d.ts",
      "import": "./dist/provider/openrouter.js"
    },
    "./openai-compat": {
      "types": "./dist/provider/openai-compat.d.ts",
      "import": "./dist/provider/openai-compat.js"
    },
    "./deterministic": {
      "types": "./dist/provider/deterministic.d.ts",
      "import": "./dist/provider/deterministic.js"
    },
    "./presets": {
      "types": "./dist/catalog/presets.d.ts",
      "import": "./dist/catalog/presets.js"
    },
    "./embedding": {
      "types": "./dist/model/embedding.d.ts",
      "import": "./dist/model/embedding.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun tsc -p tsconfig.build.json",
    "lint": "bun --cwd ../.. oxlint packages/providers/src packages/providers/test",
    "test": "bun --cwd ../.. vitest run packages/providers/test",
    "typecheck": "bun tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "catalog:",
    "@aws-sdk/credential-provider-node": "catalog:",
    "@batonfx/core": "workspace:*",
    "@effect/ai-anthropic": "catalog:",
    "@effect/ai-openai": "catalog:",
    "@effect/ai-openai-compat": "catalog:",
    "@effect/ai-openrouter": "catalog:",
    "@smithy/types": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "description": "Effect AI provider registration helpers and model metadata for Baton",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/In-Time-Tec/batonfx.git",
    "directory": "packages/providers"
  },
  "homepage": "https://github.com/In-Time-Tec/batonfx#readme",
  "bugs": {
    "url": "https://github.com/In-Time-Tec/batonfx/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
