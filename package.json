{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "batonfx",
  "version": "0.27.6",
  "description": "Effect-native agent framework with an optional durable Runtime",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "bun turbo build",
    "check": "bun run build && prettier --cache --check . && oxlint packages apps examples scripts test && ast-grep scan --config sgconfig.yml --filter '^(no-|tenant-|update-)' && bun run typecheck && bun run repository-policy && bun run repository-graph -- check",
    "repository-policy": "bun scripts/repository-policy.ts",
    "repository-graph": "bun scripts/repository-graph.ts",
    "install-preflight": "bun scripts/install-preflight.ts",
    "dev": "bun --cwd apps/docs dev",
    "format": "prettier --write .",
    "package": "bun scripts/package-smoke.ts",
    "test": "bun run build && bun --bun vitest run",
    "typecheck": "ast-grep scan --config sgconfig.yml --filter '^effect-' --report-style short && bun turbo typecheck && bun tsc --noEmit -p tsconfig.json",
    "prepare": "effect-tsgo patch --no-typescript --oxlint"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "examples/*",
      "examples/*/*"
    ],
    "catalog": {
      "@a2a-js/sdk": "1.0.1",
      "@ag-ui/core": "0.0.57",
      "@ast-grep/cli": "0.44.0",
      "@aws-sdk/client-bedrock-runtime": "3.859.0",
      "@aws-sdk/credential-provider-node": "3.859.0",
      "@smithy/types": "4.3.1",
      "@effect/ai-anthropic": "4.0.0-beta.98",
      "@effect/ai-openai": "4.0.0-beta.98",
      "@effect/ai-openai-compat": "4.0.0-beta.98",
      "@effect/ai-openrouter": "4.0.0-beta.98",
      "@effect/platform-bun": "4.0.0-beta.98",
      "@effect/sql-mysql2": "4.0.0-beta.98",
      "@effect/sql-sqlite-bun": "4.0.0-beta.98",
      "@effect/sql-pg": "4.0.0-beta.98",
      "@effect/tsgo": "0.33.0",
      "@effect/vitest": "4.0.0-beta.98",
      "@foldkit/ui": "0.122.0",
      "@foldkit/vite-plugin": "0.10.0",
      "@modelcontextprotocol/sdk": "1.29.0",
      "@tailwindcss/vite": "4.3.2",
      "@tsconfig/bun": "1.0.9",
      "@types/bun": "1.3.13",
      "@types/node": "24.12.2",
      "@vitest/coverage-v8": "4.0.16",
      "class-variance-authority": "0.7.1",
      "clsx": "2.1.1",
      "effect": "4.0.0-beta.98",
      "foldkit": "0.122.0",
      "happy-dom": "20.10.6",
      "oxlint": "1.77.0",
      "oxlint-tsgolint": "7.0.2001",
      "prettier": "3.6.2",
      "tailwind-merge": "3.6.0",
      "tailwindcss": "4.3.2",
      "turbo": "2.8.13",
      "typescript": "7.0.2",
      "vite": "8.1.3",
      "vitest": "4.0.16"
    },
    "catalogs": {
      "peer": {
        "foldkit": ">=0.122.0 <1"
      }
    }
  },
  "dependencies": {
    "@batonfx/a2a": "workspace:*",
    "@batonfx/ag-ui": "workspace:*",
    "@batonfx/core": "workspace:*",
    "@batonfx/foldkit": "workspace:*",
    "@batonfx/harness": "workspace:*",
    "@batonfx/memory": "workspace:*",
    "@batonfx/mcp": "workspace:*",
    "@batonfx/providers": "workspace:*",
    "@batonfx/repl": "workspace:*",
    "@batonfx/runtime": "workspace:*",
    "@batonfx/skills": "workspace:*",
    "@batonfx/test": "workspace:*",
    "@batonfx/transport": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@ast-grep/cli": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/sql-mysql2": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false
  }
}
