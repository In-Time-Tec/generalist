{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@batonfx/mcp",
  "version": "0.19.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./baton": {
      "types": "./dist/mcp/baton.d.ts",
      "import": "./dist/mcp/baton.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun tsc -p tsconfig.build.json",
    "lint": "bun --cwd ../.. oxlint packages/mcp/src packages/mcp/test",
    "test": "bun --cwd ../.. vitest run packages/mcp/test",
    "typecheck": "bun tsc --noEmit"
  },
  "dependencies": {
    "@batonfx/core": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "@batonfx/test": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "description": "Model Context Protocol toolkit discovery and Baton tool execution adapter",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/In-Time-Tec/batonfx.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/In-Time-Tec/batonfx#readme",
  "bugs": {
    "url": "https://github.com/In-Time-Tec/batonfx/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
