{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@batonfx/a2a",
  "version": "0.20.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun tsc -p tsconfig.build.json",
    "lint": "bun --cwd ../.. oxlint packages/a2a/src packages/a2a/test",
    "test": "bun --bun --cwd ../.. vitest run packages/a2a/test",
    "typecheck": "bun tsc --noEmit"
  },
  "dependencies": {
    "@a2a-js/sdk": "catalog:",
    "@batonfx/runtime": "workspace:*"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "description": "A2A v1 server adapter for the Baton Runtime",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/In-Time-Tec/batonfx.git",
    "directory": "packages/a2a"
  },
  "homepage": "https://github.com/In-Time-Tec/batonfx#readme",
  "bugs": {
    "url": "https://github.com/In-Time-Tec/batonfx/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
